# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# E2E tests support only local and staging targets. Production is intentionally
# unsupported. `npm run test:e2e` uses local; `npm run test:e2e:staging` uses staging.
E2E_TARGET=local

E2E_LOCAL_BASE_URL=http://localhost:3000
E2E_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
E2E_LOCAL_SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
E2E_LOCAL_USER_EMAIL=local-test-user@example.com
E2E_LOCAL_USER_PASSWORD=local-test-password
E2E_LOCAL_SECOND_USER_EMAIL=local-second-test-user@example.com
E2E_LOCAL_SECOND_USER_PASSWORD=local-second-test-password
E2E_LOCAL_USER_ID=
E2E_LOCAL_SECOND_USER_ID=

# Staging URLs are fixed in tests/e2e/support/env.ts to prevent accidental
# Production writes. Put real secrets only in .env.staging.local.
E2E_STAGING_SUPABASE_SECRET_KEY=your-staging-secret-key
E2E_STAGING_USER_EMAIL=staging-test-user@example.com
E2E_STAGING_USER_PASSWORD=staging-test-password
E2E_STAGING_SECOND_USER_EMAIL=staging-second-test-user@example.com
E2E_STAGING_SECOND_USER_PASSWORD=staging-second-test-password
E2E_STAGING_USER_ID=
E2E_STAGING_SECOND_USER_ID=
VERCEL_AUTOMATION_BYPASS_SECRET=your-vercel-automation-bypass-secret
